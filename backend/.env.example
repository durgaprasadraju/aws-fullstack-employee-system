# Server
NODE_ENV=development
PORT=3001

# Database — Writer endpoint for mutations, Reader for SELECT
DB_WRITER_HOST=localhost
DB_READER_HOST=localhost
DB_PORT=3306
DB_NAME=employee_management
DB_USER=ems_user
DB_PASSWORD=ems_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=change-me-in-production-use-secrets-manager
JWT_EXPIRES_IN=24h

# AWS (use IAM roles in production — no access keys)
AWS_REGION=us-east-1
S3_BUCKET=ems-profile-pictures
# AWS_ENDPOINT_URL=http://localhost:4566  # LocalStack only

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Secrets Manager secret name (production)
DB_SECRET_NAME=ems/rds/credentials
